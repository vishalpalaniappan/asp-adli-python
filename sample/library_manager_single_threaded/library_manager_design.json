{
    "description": "Contains the design for library manager v2. The ID's refer to abstractions that can be observed from the execution of a system. This allows you to construct design level traces from execution that is distributed across nodes, threads and processes.",
    "design": [
        {
            "name": "LibraryManager",
            "id": "LibraryManagerModule",
            "action": "The user selected <option_SelectMenuOptionStep>.",
            "type": "atomic",
            "entry": "SelectDisplayMenu",
            "steps": [
                {
                    "type": "sequential",
                    "id": "DisplayMenuStep",
                    "behavior": [
                        "SelectDisplayMenu"
                    ]
                },
                {
                    "type": "selector",
                    "mutex": true,
                    "id": "SelectMenuOptionStep",
                    "options": [
                        {
                            "id": "AddBooksToBasketModule",
                            "value": "add books to the basket",                            
                            "module": "SelectRequestBook"
                        },
                        {
                            "id": "PlaceBooksOnShelfModule",
                            "value": "place books from basket onto the shelf",
                            "module": "SelectCheckIfTooManyBooks"
                        },
                        {
                            "id": "DisplayBooksModule",
                            "value": "display the contents of the library",
                            "module": "SelectDisplayLibrary"
                        },
                        {
                            "id": "ExitProgramModule",
                            "value": "leave the library",
                            "module": "SelectTerminateProgram"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Add Books to Basket",
            "id": "AddBooksToBasketModule",
            "action": "The user submitted a book named <book_name> with genre <book_genre> and it was added to the basket.",
            "description": "Accept Book From User and Add to Basket",
            "entry": "SelectRequestBook",
            "steps": [
                {
                    "type": "sequential",
                    "id": "RequestBook",
                    "behavior": [
                        "SelectRequestBook"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "AcceptBookName",
                    "behavior": [
                        "SelectAcceptBookName"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "AcceptBookGenre",
                    "behavior": [
                        "SelectAcceptBookGenre"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "AddBookToBasket",
                    "behavior": [
                        "SelectAddBookToBasket"
                    ]
                }
            ]
        },
        {
            "name": "Place Books on Shelf",
            "id": "PlaceBooksOnShelfModule",
            "action": "Picked up <num_books_from_steps> books from the basket and placed on the shelf.",
            "entry": "SelectCheckIfTooManyBooks",
            "steps": [
                {
                    "type": "sequential",
                    "id": "CheckIfTooManyBooksStep",
                    "behavior": [
                        "SelectCheckIfTooManyBooks"
                    ]
                },
                {
                    "type": "selector",
                    "mutex": false,
                    "id": "SelectCheckIfTooManyBooksStep",
                    "options": [
                        {
                            "id": "SelectTooManyBooksModule",
                            "module": "SelectTooManyBooks"
                        }
                    ]
                },
                {
                    "type": "sequential",
                    "id": "CheckBasketForBookStep",
                    "behavior": [
                        "SelectCheckBasketForBook"
                    ]
                },
                {
                    "type": "selector",
                    "mutex": false,
                    "id": "SelectBasketHasBookStep",
                    "options": [
                        {
                            "id": "GetBookFromBasketModule",
                            "module": "SelectGettingBookFromBasket"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Select Too Many Books",
            "id": "SelectTooManyBooksModule",
            "entry": "SelectTooManyBooks",
            "steps": [
                {
                    "type": "sequential",
                    "id": "SelectTooManyBooksStep",
                    "behavior": [
                        "SelectTooManyBooks"
                    ]
                }
            ]
        },
        {
            "name": "Get Book From Basket",
            "id": "GetBookFromBasketModule",
            "entry": "SelectGettingBookFromBasket",
            "action": "Got a book named <name_of_book_from_basket> from the basket and added it to the shelf in the slot named <first_letter_of_book_name><created_slot_for_letter>.",
            "steps": [
                {
                    "type": "sequential",
                    "id": "GettingBookFromBasketStep",
                    "behavior": [
                        "SelectGettingBookFromBasket"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "CheckIfShelfHasSlotStep",
                    "behavior": [
                        "SelectCheckingIfShelfHasSlot"
                    ]
                },
                {
                    "type": "selector",
                    "mutex": false,
                    "id": "SelectCreateSlotForBookStep",
                    "options": [
                        {
                            "id": "CreateSlotForBookModule",
                            "module": "SelectCreateSlotForBook"
                        }
                    ]
                },
                {
                    "type": "sequential",
                    "id": "AddingBookToShelfStep",
                    "goto": {
                        "module": "PlaceBooksOnShelfModule",
                        "step": 3
                    },
                    "behavior": [
                        "SelectAddingBookToShelf"
                    ]
                }
            ]
        },
        {
            "name": "Create Slot For Book",
            "id": "CreateSlotForBookModule",
            "action": "Created slot for letter <created_slot_for_letter> on the bookshelf",
            "entry": "SelectCreateSlotForBook",
            "steps": [
                {
                    "type": "sequential",
                    "id": "SelectCreateSlotForBook",
                    "behavior": [
                        "SelectCreateSlotForBook"
                    ]
                }
            ]
        },
        {
            "name": "Display Books",
            "id": "DisplayBooksModule",
            "entry": "SelectDisplayLibrary",
            "steps": [
                {
                    "type": "sequential",
                    "id": "DisplayLibraryStep",
                    "behavior": [
                        "SelectDisplayLibrary"
                    ]
                }
            ]
        },
        {
            "name": "Exit Program",
            "id": "ExitProgramModule",
            "entry": "SelectTerminateProgram",
            "steps": [
                {
                    "type": "sequential",
                    "id": "ExitStep",
                    "behavior": [
                        "SelectTerminateProgram"
                    ]
                }
            ]
        }
    ],
    "behavior": [
        {
            "id": "SelectDisplayMenu",
            "atomic": true,
            "intent": "Displayed the menu to user and they selected the response <response>.",
            "placeholders": [
                {
                    "string": "<response>",
                    "type": "value",
                    "participantName": "response"
                }
            ],
            "participants": [
                {
                    "name": "response",
                    "functionalId": "PromptUserForChoice",
                    "scope": "local"
                }
            ],
            "abstractions": [
                "ChooseToDisplayMenu",
                "PromptUserForChoice",
                "CheckIfUserChoseAddBook",
                "CheckIfUserChosePlaceBook",
                "CheckIfUserChoseDisplayLibrary"
            ]
        },
        {
            "id": "SelectRequestBook",
            "intent": "Librarian requests the book from the user.",
            "abstractions": [
                "AcceptBookInformation",
                "DisplayRequest"
            ]
        },
        {
            "id": "SelectAcceptBookName",
            "intent": "Librarian requests and accepts book name from the user.",
            "abstractions": [
                "AcceptBookName"
            ]
        },
        {
            "id": "SelectAcceptBookGenre",
            "intent": "Librarian requests and accepts book genre from the user.",
            "abstractions": [
                "AcceptBookGenre"
            ]
        },
        {
            "id": "SelectAddBookToBasket",
            "intent": "Librarian adds book to basket.",
            "abstractions": [
                "AssembleBookDetails",
                "ReturnBookDetails",
                "AddBookToBasket"
            ]
        },
        {
            "id": "SelectCheckIfTooManyBooks",
            "intent": "Checked if there are more than 5 books in the basket.",
            "participants": [
                {
                    "name": "basket",
                    "functionalId": "CheckIfTooManyBooks",
                    "scope": "local"
                }
            ],
            "abstractions": [
                "CheckIfTooManyBooks"
            ]
        },
        {
            "id": "SelectTooManyBooks",
            "intent": "Artificially raise exception if there are too many books.",
            "abstractions": [
                "FailIfTooManyBooks"
            ]
        },
        {
            "id": "SelectCheckBasketForBook",
            "intent": "The basket has <num_books> book(s) in it.",
            "placeholders": [
                {
                    "string": "<num_books>",
                    "type": "semantic_property",
                    "participantName": "basket",
                    "property": "length"
                }
            ],
            "participants": [
                {
                    "name": "basket",
                    "functionalId": "CheckingBasketForBook",
                    "scope": "local"
                }
            ],
            "abstractions": [
                "CheckingBasketForBook",
                "ReturnBookShelf"
            ]
        },
        {
            "id": "SelectGettingBookFromBasket",
            "intent": "Got a book named <book_name> from the basket.",
            "placeholders": [
                {
                    "string": "<book_name>",
                    "type": "key_value",
                    "participantName": "book",
                    "keys": ["name"]
                }
            ],
            "participants": [
                {
                    "name": "book",
                    "functionalId": "GettingBookFromBasket",
                    "scope": "local"
                }
            ],
            "abstractions": [
                "GettingBookFromBasket",
                "DisplayBookInformation",
                "GettingFirstNameOfBook"
            ]
        },
        {
            "id": "SelectCheckingIfShelfHasSlot",
            "intent": "Checking if shelf has a slot for the letter <first_letter>",
            "placeholders": [
                {
                    "string": "<first_letter>",
                    "type": "value",
                    "participantName": "firstLetter"
                }
            ],
            "participants": [
                {
                    "name": "book",
                    "functionalId": "CheckingIfShelfHasSlot",
                    "scope": "local"
                },
                {
                    "name": "book_shelf",
                    "functionalId": "CheckingIfShelfHasSlot",
                    "scope": "local"    
                },
                {
                    "name": "firstLetter",
                    "provenance": "book",
                    "functionalId": "CheckingIfShelfHasSlot",
                    "scope": "local"    
                }
            ],
            "abstractions": [
                "CheckingIfShelfHasSlot"
            ]
        },
        {
            "id": "SelectCreateSlotForBook",
            "intent": "Creating a slot for the letter <first_letter>",
            "placeholders": [
                {
                    "string": "<first_letter>",
                    "type": "value",
                    "participantName": "firstLetter"
                }
            ],
            "participants": [
                {
                    "name": "book",
                    "functionalId": "CreateSlotForBookOnShelf",
                    "scope": "local"
                },
                {
                    "name": "book_shelf",
                    "functionalId": "CreateSlotForBookOnShelf",
                    "scope": "local"    
                },
                {
                    "name": "firstLetter",
                    "provenance": "book",
                    "functionalId": "CreateSlotForBookOnShelf",
                    "scope": "local"    
                }
            ],
            "abstractions": [
                "CreateSlotForBookOnShelf"
            ]
        },
        {
            "id": "SelectAddingBookToShelf",
            "intent": "Adding a book named <book_name> with genre <book_genre> to the shelf.",
            "placeholders": [
                {
                    "string": "<book_name>",
                    "type": "key_value",
                    "participantName": "book",
                    "keys": ["name"]
                },
                {
                    "string": "<book_genre>",
                    "type": "key_value",
                    "participantName": "book",
                    "keys": ["genre"]
                }
            ],
            "participants": [
                {
                    "name": "book",
                    "functionalId": "AddingBookToShelf",
                    "scope": "local"
                },
                {
                    "name": "book_shelf",
                    "functionalId": "AddingBookToShelf",
                    "scope": "local"    
                }
            ],
            "abstractions": [
                "AddingBookToShelf"
            ]
        },
        {
            "id": "SelectSaveUpdatedBookSHelf",
            "intent": "Save the updated bookshelf.",
            "abstractions": [
                "ReturnBookShelf"
            ]
        },
        {
            "id": "SelectDisplayLibrary",
            "intent": "Displayed the contents of the library.",
            "participants": [
                {
                    "name": "basket",
                    "functionalId": "DisplayBasket",
                    "scope": "local"
                },
                {
                    "name": "book_shelf",
                    "functionalId": "DisplayBookShelf",
                    "scope": "local"    
                }
            ],
            "abstractions": [
                "DisplayBookShelf",
                "DisplayBasket"
            ]
        },
        {
            "id": "SelectTerminateProgram",
            "intent": "Terminated the library manager.",
            "abstractions": [
                "ExitTheMenu"
            ]
        }
    ]
}