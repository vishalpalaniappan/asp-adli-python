{
    "description": "Contains the design for library manager v2. The ID's refer to abstractions that can be observed from the execution of a system. This allows you to construct design level traces from execution that is distributed across nodes, threads and processes.",
    "design": [
        {
            "name": "LibraryManager",
            "entry": {
                "type": "atomic",
                "behavior": "SelectDisplayMenu"
            },
            "steps": [
                {
                    "type": "sequential",
                    "id": "LibraryManagerEntry",
                    "behavior": [
                        "SelectDisplayMenu"
                    ]
                },
                {
                    "type": "selector",
                    "id": "MenuOptions",
                    "options": [
                        {
                            "id": "AddBookToBasket",
                            "behavior": [
                                "SelectAcceptBookAndAddToBasket"
                            ]
                        },
                        {
                            "id": "PlaceBooks",
                            "behavior": [
                                "SelectPlaceBooksOnShelf"
                            ]
                        },
                        {
                            "id": "DisplayBooks",
                            "behavior": [
                                "SelectDisplayLibrary"
                            ]
                        },
                        {
                            "id": "Exit",
                            "behavior": [
                                "SelectTerminateProgram"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "name": "Add Books to Basket",
            "entry": {
                "behavior": "SelectAcceptBookAndAddToBasket"
            },
            "steps": [
                {
                    "id": "AddBookToBasket",
                    "behavior": [
                        "SelectAcceptBookAndAddToBasket"
                    ]
                }
            ]
        },
        {
            "name": "Place Books On Shelf",
            "entry": {
                "behavior": "SelectPlaceBooksOnShelf"
            },
            "steps": [
                {
                    "id": "PlaceBooks",
                    "behavior": [
                        "SelectPlaceBooksOnShelf"
                    ]
                }
            ]
        },
        {
            "name": "Display Books",
            "entry": {
                "behavior": "SelectDisplayLibrary"
            },
            "steps": [
                {
                    "id": "DisplayBooks",
                    "behavior": [
                        "SelectDisplayLibrary"
                    ]
                }
            ]
        },
        {
            "name": "Exit Program",
            "entry": {
                "behavior": "SelectTerminateProgram"
            },
            "steps": [
                {
                    "id": "Exit",
                    "behavior": [
                        "SelectTerminateProgram"
                    ]
                }
            ]
        }
    ],
    "behavior": [
        {
            "id": "SelectDisplayMenu",
            "atomic": true,
            "intent": "Show menu to user and accept their choice.",
            "abstractions": [
                "ChooseToDisplayMenu",
                "PromptUserForChoice",
                "CheckIfUserChoseAddBook",
                "CheckIfUserChosePlaceBook",
                "CheckIfUserChoseDisplayLibrary"
            ]
        },
        {
            "id": "SelectAcceptBookAndAddToBasket",
            "intent": "Accepted a book named <name> with genre <genre> and added it to the basket.",
            "variables": [
                {
                    "name": "book_details",
                    "placeholder": "<name>",
                    "scope": "local",
                    "key": "name"
                },
                {
                    "name": "book_details",
                    "placeholder": "<genre>",
                    "scope": "local",
                    "key": "genre"
                }
            ],
            "abstractions": [
                "AcceptBookInformation",
                "DisplayRequest",
                "AcceptBookName",
                "AcceptBookGenre",
                "AssembleBookDetails",
                "ReturnBookDetails",
                "AddBookToBasket"
            ]
        },
        {
            "id": "SelectPlaceBooksOnShelf",
            "intent": "Placed <num_books> book(s) on the shelf.",
            "meta_intent": "Created <num_slots> new slots for the book(s) on the shelf.",
            "variables": [
                {
                    "name": "basket",
                    "placeholder": "<num_books>",
                    "scope": "local",
                    "key": "length"
                }
            ],
            "behavioral_variables": [
                {
                    "placeholder": "<num_slots>",
                    "id": "CreateSlotForBookOnShelf",
                    "type": "count"
                }
            ],
            "abstractions": [
                "CheckIfTooManyBooks",
                "PlaceBooksOnShelf",
                "CheckingBasketForBook",
                "ReturnBookShelf"
            ]
        },
        {
            "id": "SelectFailIfTooManyBooks",
            "intent": "Failed because there are more than 6 books in the basket (<num_books> books)",
            "variables": [
                {
                    "name": "basket",
                    "placeholder": "<num_books>",
                    "scope": "local",
                    "key": "length"
                }
            ],
            "group": "FailIfTooManyBooksGroup",
            "abstractions": [
                "FailIfTooManyBooks"
            ]
        },
        {
            "id": "SelectPlaceBookOnShelf",
            "intent": "Placed book named <name> with genre <genre> on the shelf.",
            "variables": [
                {
                    "name": "book",
                    "placeholder": "<name>",
                    "scope": "local",
                    "key": "name"
                },
                {
                    "name": "book",
                    "placeholder": "<genre>",
                    "scope": "local",
                    "key": "genre"
                }
            ],
            "abstractions": [
                "GettingBookFromBasket",
                "DisplayBookInformation",
                "GettingFirstNameOfBook",
                "CheckingIfShelfHasSlot",
                "AddingBookToShelf"
            ]
        },
        {
            "id": "SelectCreateSlotForBook",
            "intent": "Create slot for the letter <letter> on the shelf. ",
            "variables": [
                {
                    "name": "firstLetter",
                    "placeholder": "<letter>",
                    "scope": "local"
                }
            ],
            "abstractions": [
                "CreateSlotForBookOnShelf"
            ]
        },
        {
            "id": "SelectDisplayLibrary",
            "intent": "Displayed the contents of the library.",
            "abstractions": [
                "DisplayBookShelf",
                "DisplayBasket"
            ]
        },
        {
            "id": "SelectTerminateProgram",
            "intent": "Terminated the library manager.",
            "abstractions": [
                "ExitTheMenu"
            ]
        }
    ]
}