{
    "description": "Contains the behavioral abstractions of the multi-threaded library manager.",
    "behavior": [
        {
            "id": "SelectMenu",
            "actor": "Library Manager",
            "intent": "Get menu selection from user.",
            "abstractions": [
                "EnterMenu",
                "GetSelection",
                "CheckIfAcceptBook",
                "CheckIfPlaceBook",
                "CheckIfDisplay"
            ]
        },
        {
            "id": "SelectDisplayAction",
            "actor": "Library Manager",
            "intent": "Select action to display library conents.",
            "abstractions": [
                "PrepareDisplayTask",
                "SendBasketToDisplay"
            ]
        },
        {
            "id": "SelectPlaceBookAction",
            "actor": "Library Manager",
            "intent": "Select action to place contents from basket onto shelf.",
            "abstractions": [
                "PreparePlaceTask",
                "SendBasketToPlaceOnShelf",
                "ClearBasketAfterPlacingContentsOnShelf"
            ]
        },
        {
            "id": "SelectAcceptBookAction",
            "actor": "Library Manager",
            "intent": "Select action to add contents to basket.",
            "abstractions": [
                "AcceptBookInformation",
                "DisplayRequest",
                "AcceptBookName",
                "AcceptBookGenre",
                "AssembleBookDetails",
                "ReturnBookDetails",
                "AddBookToBasket"
            ]
        },
        {
            "id": "SelectMsgBookShelf",
            "actor": "BookShelf Manager",
            "type": "atomic",
            "intent": "Select the message in the bookshelf thread.",
            "abstractions": [
                "ReadMessage",
                "CheckIfPlaceBooksMsg",
                "CheckIfDisplayMsg",
                "CheckIfQuitMsg"
            ]
        },
        {
            "id": "SelectPlaceBookMsg",
            "actor": "BookShelf Manager",
            "intent": "Place books from basket on shelf.",
            "abstractions": [
                "PrintFormattingLine",
                "PlaceBooksOnShelf",
                "CheckingBasketForBook"
            ]
        },
        {
            "id": "SelectPlaceBookOnShelf",
            "actor": "BookShelf Manager",
            "intent": "Place book on shelf.",
            "abstractions": [
                "GettingBookFromBasket",
                "DisplayBookInformation",
                "GettingFirstNameOfBook",
                "CheckingIfShelfHasSlot",
                "AddingBookToShelf"
            ]
        },
        {
            "id": "SelectCreateSlotForBook",
            "actor": "BookShelf Manager",
            "intent": "Create slot for the letter <letter> on the shelf. ",
            "abstractions": [
                "CreateSlotForBookOnShelf"
            ]
        },
        {
            "id": "SelectDisplayLibrary",
            "actor": "BookShelf Manager",
            "intent": "Display contents of library.",
            "abstractions": [
                "DisplayBookShelf",
                "DisplayBasket"
            ]
        }
    ]
}