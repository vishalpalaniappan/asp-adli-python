{
    "description": "Contains the behavioral abstractions of the multi-threaded library manager.",
    "behavior": [
        {
            "id": "SelectMenu",
            "intent": "Display Menu to User.",
            "abstractions": [
                "EnterMenu",
                "GetSelection",
                "CheckIfAcceptBook",
                "CheckIfPlaceBook",
                "CheckIfDisplay"
            ]
        },
        {
            "id": "SelectAcceptBookAction",
            "intent": "Select action to add contents to basket.",
            "abstractions": [
                "AcceptBookInformation",
                "DisplayRequest",
                "AcceptBookName",
                "AcceptBookGenre",
                "AssembleBookDetails",
                "ReturnBookDetails",
                "AddBookToBasket"
            ]
        },
        {
            "id": "SelectDisplayAction",
            "intent": "Select action to display library conents.",
            "abstractions": [
                "PrepareDisplayTask",
                "SendBasketToDisplay",
                "ReadMessage",
                "CheckIfDisplayMsg",
                "CheckIfQuitMsg"
            ]
        },
        {
            "id": "SelectDisplayLibrary",
            "intent": "Display Library.",
            "abstractions": [
                "DisplayBookShelf",
                "DisplayBasket"
            ]
        }
    ]
}