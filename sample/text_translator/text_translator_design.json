{
    "description": "Contains the design and behavioral abstractions of the multi-threaded data processor.",
    "design": [
        {
            "name": "ProcessData",
            "id": "ProcessDataModule",
            "description": "This design abstraction accepts data from the user at the producer, leverages three workers to process the data and then aggregates the results in the consumer before finishing the job.",
            "type": "atomic",
            "entry": "SelectMainMenuAndAcceptData",
            "steps": [
                {
                    "type": "sequential",
                    "id": "DisplayMenuAndAcceptDataStep",
                    "behavior": [
                        "SelectMainMenuAndAcceptData"
                    ]
                },
                {
                    "type": "fanout",
                    "id": "WorkerAFanoutStep",
                    "fanoutRef": "WORKERS",
                    "module": "SelectSendJobToSpanishTranslator"
                },
                {
                    "type": "fanout",
                    "id": "WorkerBFanoutStep",
                    "fanoutRef": "WORKERS",
                    "module": "SelectSendJobToFrenchTranslator"
                },
                {
                    "type": "fanout",
                    "id": "WorkerCFanoutStep",
                    "fanoutRef": "WORKERS",
                    "module": "SelectSendJobToTamilTranslator"
                },
                {
                    "type": "sequential",
                    "id": "ThrottleIngestionStep",
                    "behavior": [
                        "SelectThrottleIngestion"
                    ]
                }
            ]
        },
        {
            "id": "TranslateWithFrenchTranslator",
            "type": "fork",
            "entry": "SelectSendJobToFrenchTranslator",
            "steps": [
                {
                    "type": "sequential",
                    "id": "ProcessDataWithFrenchTranslatorStep",
                    "behavior": [
                        "SelectSendJobToFrenchTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "ReceiveDataInFrenchTranslatorStep",
                    "behavior": [
                        "SelectReceiveMessageFrenchTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "ProcessReceivedMessageInFrenchTranslatorStep",
                    "behavior": [
                        "SelectProcessReceivedMsgFrenchTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "SendResultsToConsumerFrenchTranslatorStep",
                    "behavior": [
                        "SelectSendProcessedResultsToConsumerFrenchTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "ReceiveMessageInConsumer",
                    "behavior": [
                        "SelectReceiveMessageConsumer"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "IncrementJobStatusPackerStep",
                    "behavior": [
                        "SelectIncrementJobStatusPacker"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "CheckIfJobDoneStep",
                    "behavior": [
                        "SelectIsJobDone"
                    ]
                },
                {
                    "type": "selector",
                    "mutex": false,
                    "id": "SelectCleanupJobStep",
                    "options": [
                        {
                            "id": "SelectCleanupJob",
                            "module": "SelectCleanupJob"
                        }
                    ]
                }
            ]
        },
        {
            "id": "TranslateWithSpanishTranslator",
            "type": "fork",
            "entry": "SelectSendJobToSpanishTranslator",
            "steps": [
                {
                    "type": "sequential",
                    "id": "ProcessDataWithSpanishTranslatorStep",
                    "behavior": [
                        "SelectSendJobToSpanishTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "ReceiveDataInSpanishTranslatorStep",
                    "behavior": [
                        "SelectReceiveMessageSpanishTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "ProcessReceivedMessageInSpanishTranslator",
                    "behavior": [
                        "SelectProcessReceivedMsgSpanishTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "SendResultsToConsumerSpanishTranslator",
                    "behavior": [
                        "SelectSendProcessedResultsToConsumerSpanishTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "ReceiveMessageInConsumer",
                    "behavior": [
                        "SelectReceiveMessageConsumer"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "IncrementJobStatusPackerStep",
                    "behavior": [
                        "SelectIncrementJobStatusPacker"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "CheckIfJobDoneStep",
                    "behavior": [
                        "SelectIsJobDone"
                    ]
                },
                {
                    "type": "selector",
                    "mutex": false,
                    "id": "SelectCleanupJobStep",
                    "options": [
                        {
                            "id": "SelectCleanupJob",
                            "module": "SelectCleanupJob"
                        }
                    ]
                }
            ]
        },
        {
            "id": "TranslateWithTamilTranslator",
            "type": "fork",
            "entry": "SelectSendJobToTamilTranslator",
            "steps": [
                {
                    "type": "sequential",
                    "id": "ProcessDataWithTamilTranslatorStep",
                    "behavior": [
                        "SelectSendJobToTamilTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "ReceiveDataInTamilTranslatorStep",
                    "behavior": [
                        "SelectReceiveMessageTamilTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "ProcessReceivedMessageInTamilTranslator",
                    "behavior": [
                        "SelectProcessReceivedMsgTamilTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "SendResultsToConsumerTamilTranslator",
                    "behavior": [
                        "SelectSendProcessedResultsToConsumerTamilTranslator"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "ReceiveMessageInConsumer",
                    "behavior": [
                        "SelectReceiveMessageConsumer"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "IncrementJobStatusPackerStep",
                    "behavior": [
                        "SelectIncrementJobStatusPacker"
                    ]
                },
                {
                    "type": "sequential",
                    "id": "CheckIfJobDoneStep",
                    "behavior": [
                        "SelectIsJobDone"
                    ]
                },
                {
                    "type": "selector",
                    "mutex": false,
                    "id": "SelectCleanupJobStep",
                    "options": [
                        {
                            "id": "SelectCleanupJob",
                            "module": "SelectCleanupJob"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Cleanup job.",
            "entry": "SelectCleanupJob",
            "steps": [
                {
                    "type": "sequential",
                    "id": "SelectCleanupJob",
                    "behavior": [
                        "SelectCleanupJob"
                    ]
                }
            ]
        }
    ],
    "behavior": [
        {
            "id": "SelectMainMenuAndAcceptData",
            "atomic": true,
            "intent": "Get the data to process from the user.",
            "abstractions": [
                "EnterDataIngestorLoop",
                "AcceptData"
            ]
        },
        {
            "id": "SelectSendJobToFrenchTranslator",
            "intent": "Send jobs to french translator.",
            "target": "worker",
            "abstractions": [
                "SendTextToFrenchTranslator"
            ]
        },
        {
            "id": "SelectSendJobToSpanishTranslator",
            "intent": "Send jobs to spanish translator.",
            "target": "worker",
            "abstractions": [
                "SendDataToSpanishTranslator"
            ]
        },
        {
            "id": "SelectSendJobToTamilTranslator",
            "intent": "Send jobs to tamil translator.",
            "target": "worker",
            "abstractions": [
                "SendDataToTamilTranslator"
            ]
        },
        {
            "id": "SelectThrottleIngestion",
            "intent": "Throttle the ingestion.",
            "abstractions": [
                "SleepToThrottleIngestion"
            ]
        },


        {
            "id": "SelectReceiveMessageTamilTranslator",
            "intent": "Receive text in tamil translator.",
            "abstractions": [
                "MainLoopTamilTranslator",
                "TryToReceiveMessageTamilTranslator",
                "ReceiveMessageTamilTranslator"
            ]
        },
        {
            "id": "SelectNoMsgReceivedTamilWorker",
            "intent": "No message received in tamil worker.",
            "abstractions": [
                "CatchNoMsgExceptionTamilTranslator",
                "ContinueRecvMessagesTamilTranslator"
            ]
        },
        {
            "id": "SelectProcessReceivedMsgTamilTranslator",
            "intent": "Process Received Message in Worker.",
            "abstractions": [
                "DisplayReceivedMessageTamilTranslator",
                "ProcessMessageTamilTranslator"
            ]
        },
        {
            "id": "SelectSendProcessedResultsToConsumerTamilTranslator",
            "intent": "Send Processed Results to Consumer.",
            "target": "consumer",
            "abstractions": [
                "PutProcessedResultInQueueTamilTranslator"
            ]
        },

        

        {
            "id": "SelectReceiveMessageSpanishTranslator",
            "intent": "Receive text in spanish translator.",
            "abstractions": [
                "MainLoopSpanishTranslator",
                "TryToReceiveMessageSpanishTranslator",
                "ReceiveMessageSpanishTranslator"
            ]
        },
        {
            "id": "SelectProcessReceivedMsgSpanishTranslator",
            "intent": "No message received in spanish worker.",
            "abstractions": [
                "CatchNoMsgExceptionSpanishTranslator",
                "ContinueRecvMessagesSpanishTranslator"
            ]
        },
        {
            "id": "SelectProcessReceivedMsgSpanishTranslator",
            "intent": "Process Received Message in spanish translator.",
            "abstractions": [
                "DisplayReceivedMessageTamilTranslator",
                "ProcessMessageTamilTranslator"
            ]
        },
        {
            "id": "SelectSendProcessedResultsToConsumerSpanishTranslator",
            "intent": "Send Processed Results to packer.",
            "target": "consumer",
            "abstractions": [
                "PutProcessedResultInQueueSpanishTranslator"
            ]
        },

        

        {
            "id": "SelectReceiveMessageFrenchTranslator",
            "intent": "Receive text in french translator.",
            "abstractions": [
                "MainLoopFrenchTranslator",
                "TryToReceiveMessageFrenchTranslator",
                "ReceiveMessageFrenchTranslator"
            ]
        },
        {
            "id": "SelectProcessReceivedMsgFrenchTranslator",
            "intent": "No message received in french worker.",
            "abstractions": [
                "CatchNoMsgExceptionFrenchTranslator",
                "ContinueRecvMessagesFrenchTranslator"
            ]
        },
        {
            "id": "SelectProcessReceivedMsgFrenchTranslator",
            "intent": "Process Received Message in french translator.",
            "abstractions": [
                "DisplayReceivedMessageFrenchTranslator",
                "ProcessMessageFrenchTranslator"
            ]
        },
        {
            "id": "SelectSendProcessedResultsToConsumerFrenchTranslator",
            "intent": "Send Processed Results to packer.",
            "target": "consumer",
            "abstractions": [
                "PutProcessedResultInQueueFrenchTranslator"
            ]
        },


        


        {
            "id": "SelectReceiveMessageConsumer",
            "intent": "Receive message in packer.",
            "abstractions": [
                "MainLoopPacker",
                "TryToReceiveMessagePacker",
                "ReceiveMessagePacker"
            ]
        },
        {
            "id": "SelectIncrementJobStatusPacker",
            "intent": "Increment the job status in packer.",
            "abstractions": [
                "IncrementJobStatusPacker"
            ]
        },
        {
            "id": "SelectNoMsgReceivedConsumer",
            "intent": "No message received in consumer.",
            "abstractions": [
                "NoMsgExceptionPacker",
                "ContinueRecvMsgPacker"
            ]
        },
        {
            "id": "SelectIsJobDone",
            "intent": "Check if the job is done.",
            "abstractions": [
                "CheckIfJobIsDonePacker"
            ]
        },
        {
            "id": "SelectCleanupJob",
            "intent": "Cleanup the completed job.",
            "abstractions": [
                "DisplayConfirmationPacker",
                "CleanUpJobStatusPacker"
            ]
        }
    ]
}