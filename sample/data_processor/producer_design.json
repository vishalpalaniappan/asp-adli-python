{
    "description": "Contains the design and behavioral abstractions of the multi-threaded data processor.",
    "design": [
        {
            "name": "ProcessData",
            "id": "ProcessDataModule",
            "description": "This design abstraction accepts data from the user at the producer, leverages three workers to process the data and then aggregates the results in the consumer before finishing the job.",
            "type": "atomic",
            "entry": "SelectMainMenuAndAcceptData",
            "steps": [
                {
                    "type": "sequential",
                    "id": "DisplayMenuAndAcceptDataStep",
                    "behavior": [
                        "SelectMainMenuAndAcceptData"
                    ]
                },
                {
                    "type": "fanout",
                    "id": "WorkerAFanoutStep",
                    "fanoutRef": "WORKERS",
                    "module": "SelectSendJobToWorkerA"
                },
                {
                    "type": "fanout",
                    "id": "WorkerBFanoutStep",
                    "fanoutRef": "WORKERS",
                    "module": "SelectSendJobToWorkerB"
                },
                {
                    "type": "fanout",
                    "id": "WorkerCFanoutStep",
                    "fanoutRef": "WORKERS",
                    "module": "SelectSendJobToWorkerC"
                },
                {
                    "type": "sequential",
                    "id": "ThrottleIngestionStep",
                    "behavior": [
                        "SelectThrottleIngestion"
                    ]
                }
            ]
        },
        {
            "name": "Process Data With Worker A",
            "id": "ProcessDataWithWorkerAModule",
            "type": "fork",
            "entry": "SelectSendJobToWorkerA",
            "steps": [
                {
                    "type": "sequential",
                    "id": "ProcessDataWithWorkerAStep",
                    "behavior": [
                        "SelectSendJobToWorkerA",
                        "SelectReceiveMessageWorker",
                        "SelectProcessReceivedMsgWorker",
                        "SelectSendProcessedResultsToConsumer",
                        "SelectReceiveMessageConsumer",
                        "SelectUpdateJobStatus"
                    ]
                },
                {
                    "type": "selector",
                    "mutex": false,
                    "id": "SelectCleanupJobStep",
                    "options": [
                        {
                            "id": "SelectCleanupJob",
                            "module": "SelectCleanupJob"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Process Data With Worker B",
            "id": "ProcessDataWithWorkerBModule",
            "type": "fork",
            "entry": "SelectSendJobToWorkerB",
            "steps": [
                {
                    "type": "sequential",
                    "id": "ProcessDataWithWorkerBStep",
                    "behavior": [
                        "SelectSendJobToWorkerB",
                        "SelectReceiveMessageWorker",
                        "SelectProcessReceivedMsgWorker",
                        "SelectSendProcessedResultsToConsumer",
                        "SelectReceiveMessageConsumer",
                        "SelectUpdateJobStatus"
                    ]
                },
                {
                    "type": "selector",
                    "mutex": false,
                    "id": "SelectCleanupJobStep",
                    "options": [
                        {
                            "id": "SelectCleanupJob",
                            "module": "SelectCleanupJob"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Process Data With Worker C",
            "id": "ProcessDataWithWorkerCModule",
            "type": "fork",
            "entry": "SelectSendJobToWorkerC",
            "steps": [
                {
                    "type": "sequential",
                    "id": "ProcessDataWithWorkerCStep",
                    "behavior": [
                        "SelectSendJobToWorkerC",
                        "SelectReceiveMessageWorker",
                        "SelectProcessReceivedMsgWorker",
                        "SelectSendProcessedResultsToConsumer",
                        "SelectReceiveMessageConsumer",
                        "SelectUpdateJobStatus"
                    ]
                },
                {
                    "type": "selector",
                    "mutex": false,
                    "id": "SelectCleanupJobStep",
                    "options": [
                        {
                            "id": "SelectCleanupJob",
                            "module": "SelectCleanupJob"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Cleanup job.",
            "entry": "SelectCleanupJob",
            "steps": [
                {
                    "type": "sequential",
                    "id": "SelectCleanupJob",
                    "behavior": [
                        "SelectCleanupJob"
                    ]
                }
            ]
        }
    ],
    "abstractions": [
        {
            "id": "SelectMainMenuAndAcceptData",
            "atomic": true,
            "intent": "Get the data to process from the user.",
            "abstractions": [
                "EnterDataIngestorLoop",
                "AcceptData"
            ]
        },
        {
            "id": "SelectSendJobToWorkerA",
            "intent": "Send jobs to worker A.",
            "target": "worker",
            "abstractions": [
                "SendDataToWorkerA"
            ]
        },
        {
            "id": "SelectSendJobToWorkerB",
            "intent": "Send jobs to worker B.",
            "target": "worker",
            "abstractions": [
                "SendDataToWorkerB"
            ]
        },
        {
            "id": "SelectSendJobToWorkerC",
            "intent": "Send jobs to worker C.",
            "target": "worker",
            "abstractions": [
                "SendDataToWorkerC"
            ]
        },
        {
            "id": "SelectThrottleIngestion",
            "intent": "Throttle the ingestion.",
            "abstractions": [
                "SleepToThrottleIngestion"
            ]
        },
        {
            "id": "SelectReceiveMessageWorker",
            "intent": "Receive message in worker.",
            "abstractions": [
                "MainLoopWorker",
                "TryToReceiveMessageWorker",
                "ReceiveMessageWorker"
            ]
        },
        {
            "id": "SelectNoMsgReceivedWorker",
            "intent": "No message received worker.",
            "abstractions": [
                "CatchNoMsgExceptionWorker",
                "ContinueRecvMessagesWorker"
            ]
        },
        {
            "id": "SelectProcessReceivedMsgWorker",
            "intent": "Process Received Message in Worker.",
            "abstractions": [
                "DisplayReceivedMessageWorker",
                "ProcessMessageWorker"
            ]
        },
        {
            "id": "SelectSendProcessedResultsToConsumer",
            "intent": "Send Processed Results to Consumer.",
            "target": "consumer",
            "abstractions": [
                "PutProcessedResultInQueueWorker"
            ]
        },
        {
            "id": "SelectReceiveMessageConsumer",
            "intent": "Receive message in consumer.",
            "abstractions": [
                "MainLoopConsumer",
                "TryToReceiveMessageConsumer",
                "ReceiveMessageConsumer"
            ]
        },
        {
            "id": "SelectNoMsgReceivedConsumer",
            "intent": "No message received in consumer.",
            "abstractions": [
                "NoMsgExceptionConsumer",
                "ContinueRecvMsgConsumer"
            ]
        },
        {
            "id": "SelectUpdateJobStatus",
            "intent": "Update the status of the job.",
            "abstractions": [
                "IncrementJobStatusConsumer",
                "CheckIfJobIsDoneConsumer"
            ]
        },
        {
            "id": "SelectCleanupJob",
            "intent": "Cleanup the completed job.",
            "abstractions": [
                "DisplayConfirmationConsumer",
                "CleanUpJobStatusConsumer"
            ]
        }
    ]
}