{
    "description": "Contains the behavioral abstractions of the multi-threaded data processor.",
    "concurrent_abstractions": [
        {
            "id": "ProcessData",
            "start": "SelectMainMenu",
            "concurrent_behaviors": [
                [
                    "SelectSendJobToWorkerA",
                    "SelectReceiveMessageWorker",
                    "SelectProcessReceivedMsgWorker",
                    "SelectReceiveMessageConsumer",
                    "SelectUpdateJobStatus"
                ],
                [
                    "SelectSendJobToWorkerB",
                    "SelectReceiveMessageWorker",
                    "SelectProcessReceivedMsgWorker",
                    "SelectReceiveMessageConsumer",
                    "SelectUpdateJobStatus"
                ],
                [
                    "SelectSendJobToWorkerC",
                    "SelectReceiveMessageWorker",
                    "SelectProcessReceivedMsgWorker",
                    "SelectReceiveMessageConsumer",
                    "SelectUpdateJobStatus"
                ]
            ],
            "end": "SelectCleanupJob"
        }
    ],
    "behavior": [
        {
            "id": "SelectMainMenu",
            "intent": "Get the data to process from the user.",
            "abstractions": [
                "EnterDataIngestorLoop",
                "AcceptData"
            ]
        },
        {
            "id": "SelectSendJobToWorkerA",
            "intent": "Send jobs to worker A.",
            "abstractions": [
                "SendDataToWorkerA"
            ]
        },
        {
            "id": "SelectSendJobToWorkerB",
            "intent": "Send jobs to worker B.",
            "abstractions": [
                "SendDataToWorkerB"
            ]
        },
        {
            "id": "SelectSendJobToWorkerC",
            "intent": "Send jobs to worker C.",
            "abstractions": [
                "SendDataToWorkerC"
            ]
        },
        {
            "id": "ThrottleIngestion",
            "intent": "Throttle the ingestion.",
            "abstractions": [
                "SleepToThrottleIngestion"
            ]
        },
        {
            "id": "SelectReceiveMessageWorker",
            "intent": "Receive message in worker.",
            "abstractions": [
                "MainLoopWorker",
                "TryToReceiveMessageWorker",
                "ReceiveMessageWorker"
            ]
        },
        {
            "id": "SelectNoMsgReceivedWorker",
            "intent": "No message received worker.",
            "abstractions": [
                "CatchNoMsgExceptionWorker",
                "ContinueRecvMessagesWorker"
            ]
        },
        {
            "id": "SelectProcessReceivedMsgWorker",
            "intent": "Process Received Message in Worker",
            "abstractions": [
                "DisplayReceivedMessageWorker",
                "PutProcessedResultInQueueWorker"
            ]
        },
        {
            "id": "SelectReceiveMessageConsumer",
            "intent": "Receive message in consumer.",
            "abstractions": [
                "MainLoopConsumer",
                "TryToReceieveMessageConsumer",
                "ReceieveMessageConsumer"
            ]
        },
        {
            "id": "SelectNoMsgReceivedConsumer",
            "intent": "No message received in consumer.",
            "abstractions": [
                "NoMsgExceptionConsumer",
                "ContinueRecvMsgConsumer"
            ]
        },
        {
            "id": "SelectUpdateJobStatus",
            "intent": "Update the status of the job.",
            "abstractions": [
                "IncrementJobStatusConsumer",
                "CheckIfJobIsDoneConsumer"
            ]
        },
        {
            "id": "SelectCleanupJob",
            "intent": "Cleanup the completed job.",
            "abstractions": [
                "DisplayConfirmationConsumer",
                "CleanUpJobStatusConsumer"
            ]
        }
    ]
}