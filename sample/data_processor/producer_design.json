{
    "description": "Contains the behavioral abstractions of the multi-threaded data processor.",
    "concurrent_abstractions": [
        {
            "id": "ProcessData",
            "type": "SplitJobTypeA",
            "type_description": "This type of concurrent abstraction splits a job between N workers. Each worker processes the job and sends the results to a single consumer who tracks when the workers have finished and cleans up the job.",
            "intention": "Processes the data provided by user by splitting the job between three workers and it aggregates the results in a consumer before finishing the job.",
            "numConcurrent": 3,
            "behaviors": [
                {
                    "id": "SelectStart",
                    "level": 1,
                    "type": "start",
                    "intention": "Begin the concurrent abstraction to process the accepted data.",
                    "behaviors": [
                        "SelectMainMenu"
                    ]
                },
                {
                    "id": "ProcessDataWithWorkerA",
                    "level": 2,
                    "type": "concurrent",
                    "intention": "Process the provided data with worker A and send to consumer.",
                    "behaviors": [
                        "SelectSendJobToWorkerA",
                        "SelectReceiveMessageWorker",
                        "SelectProcessReceivedMsgWorker",
                        "SelectSendProcessedResultsToConsumer",
                        "SelectReceiveMessageConsumer",
                        "SelectUpdateJobStatus"
                    ]
                },
                {
                    "id": "ProcessDataWithWorkerB",
                    "level": 2,
                    "type": "concurrent",
                    "intention": "Process the provided data with worker B and send to consumer.",
                    "behaviors": [
                        "SelectSendJobToWorkerB",
                        "SelectReceiveMessageWorker",
                        "SelectProcessReceivedMsgWorker",
                        "SelectSendProcessedResultsToConsumer",
                        "SelectReceiveMessageConsumer",
                        "SelectUpdateJobStatus"
                    ]
                },
                {
                    "id": "ProcessDataWithWorkerC",
                    "level": 2,
                    "type": "concurrent",
                    "intention": "Process the provided data with worker C and send to consumer.",
                    "behaviors": [
                        "SelectSendJobToWorkerC",
                        "SelectReceiveMessageWorker",
                        "SelectProcessReceivedMsgWorker",
                        "SelectSendProcessedResultsToConsumer",
                        "SelectReceiveMessageConsumer",
                        "SelectUpdateJobStatus"
                    ]
                },
                {
                    "id": "SelectEnd",
                    "level": 3,
                    "type": "end",
                    "intention": "All workers are done, so cleanup job.",
                    "behaviors": [
                        "SelectCleanupJob"
                    ]
                }
            ]
        }
    ],
    "behavior": [
        {
            "id": "SelectMainMenu",
            "atomic": true,
            "intent": "Get the data to process from the user.",
            "abstractions": [
                "EnterDataIngestorLoop",
                "AcceptData"
            ]
        },
        {
            "id": "SelectSendJobToWorkerA",
            "intent": "Send jobs to worker A.",
            "target": "worker",
            "abstractions": [
                "SendDataToWorkerA"
            ]
        },
        {
            "id": "SelectSendJobToWorkerB",
            "intent": "Send jobs to worker B.",
            "target": "worker",
            "abstractions": [
                "SendDataToWorkerB"
            ]
        },
        {
            "id": "SelectSendJobToWorkerC",
            "intent": "Send jobs to worker C.",
            "target": "worker",
            "abstractions": [
                "SendDataToWorkerC"
            ]
        },
        {
            "id": "ThrottleIngestion",
            "intent": "Throttle the ingestion.",
            "abstractions": [
                "SleepToThrottleIngestion"
            ]
        },
        {
            "id": "SelectReceiveMessageWorker",
            "intent": "Receive message in worker.",
            "abstractions": [
                "MainLoopWorker",
                "TryToReceiveMessageWorker",
                "ReceiveMessageWorker"
            ]
        },
        {
            "id": "SelectNoMsgReceivedWorker",
            "intent": "No message received worker.",
            "abstractions": [
                "CatchNoMsgExceptionWorker",
                "ContinueRecvMessagesWorker"
            ]
        },
        {
            "id": "SelectProcessReceivedMsgWorker",
            "intent": "Process Received Message in Worker.",
            "abstractions": [
                "DisplayReceivedMessageWorker",
                "ProcessMessageWorker"
            ]
        },
        {
            "id": "SelectSendProcessedResultsToConsumer",
            "intent": "Send Processed Results to Consumer.",
            "target": "consumer",
            "abstractions": [
                "PutProcessedResultInQueueWorker"
            ]
        },
        {
            "id": "SelectReceiveMessageConsumer",
            "intent": "Receive message in consumer.",
            "abstractions": [
                "MainLoopConsumer",
                "TryToReceieveMessageConsumer",
                "ReceieveMessageConsumer"
            ]
        },
        {
            "id": "SelectNoMsgReceivedConsumer",
            "intent": "No message received in consumer.",
            "abstractions": [
                "NoMsgExceptionConsumer",
                "ContinueRecvMsgConsumer"
            ]
        },
        {
            "id": "SelectUpdateJobStatus",
            "intent": "Update the status of the job.",
            "abstractions": [
                "IncrementJobStatusConsumer",
                "CheckIfJobIsDoneConsumer"
            ]
        },
        {
            "id": "SelectCleanupJob",
            "intent": "Cleanup the completed job.",
            "abstractions": [
                "DisplayConfirmationConsumer",
                "CleanUpJobStatusConsumer"
            ]
        }
    ]
}